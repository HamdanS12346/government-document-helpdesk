# Application
APP_ENV=development
APP_NAME=govt-doc-helpdesk
CHAT_DEBUG_PRINTS=false

# Upload limits
UPLOAD_MAX_ATTACHMENT_COUNT=5
UPLOAD_MAX_TOTAL_SIZE_BYTES=52428800

# OpenAI - required for normal chat, retrieval embeddings, and evaluations
OPENAI_API_KEY=

# Cohere - optional reranking
COHERE_API_KEY=

# Chroma Cloud - optional remote vector store
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION_NAME=documents-info

# Supabase - optional memory/auth persistence
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Langfuse - optional tracing and evaluation reporting
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_TEXT=false
